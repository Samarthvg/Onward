{
  "manifest_version": 3,
  "name": "Onward Autofill",
  "version": "0.2.0",
  "description": "Fills Greenhouse, Lever, Ashby and Workday job applications with your saved details. Never submits.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Autofill this application",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "src/shared/rules.js",
        "src/content/dom.js",
        "src/content/sites.js",
        "src/content/widgets.js",
        "src/content/panel.js",
        "src/content/history.js",
        "src/content/main.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["src/content/dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Autofill the application on this page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jobradar-autofill@jobradar.local",
      "update_url": "https://github.com/Samarthvg/Onward/releases/latest/download/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
